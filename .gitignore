# ---- 构建产物 ----------------------------------------------------------
# 两个构建目录只放输出，任何时候都能由 build.sh 重新生成。
# 用 build-*/ 而不是 build*，避免误伤 build.sh。
build-*/
mod/build-tmp/
mod/build-check/

# 二进制与调试符号。Windows 下 zig 每次构建都会产出这些，
# 41 个 .pdb 就占 25 MB，进历史会永久拖重仓库。
*.exe
*.dll
*.lib
*.pdb
*.obj
*.exp
*.ilk
*.map

# ---- 运行期日志与导出 --------------------------------------------------
# sink.log 单个就 348 KB，另有 sink.prev*.log / host.prev*.log 十余份。
*.log
*.out
*.err
*.prev*

# ---- 发布产物 ----------------------------------------------------------
# dist/ 是 release.sh 的输出（暂存目录 + zip + 校验和 + Release 说明），
# 随时能重新生成。zip 里装着 exe，入库既没意义又会撑大历史。
dist/

# ---- 本地备份 ----------------------------------------------------------
# 有版本控制之后 .bak 没有存在意义，历史本身就是备份。
*.bak
*.orig
*~

# ---- 第三方参考与抓包资源 ----------------------------------------------
# ame-ref 是别人的仓库（自带 .git、LICENSE、THIRD_PARTY_NOTICES），
# 混进我们的历史既不合规也没必要；出处记在 PROJECT_STATUS.md 里。
analysis/ame-ref/
# ui-probe 是从客户端解包出来的资源，ui-shots 是调试截图，
# 都属于「用户资源」范畴，不入库。
analysis/ui-probe/
analysis/ui-shots/

# ---- 编辑器 / 系统 -----------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# 本机 zig 路径（build.sh 会 source 它）。写的是开发机绝对路径，
# 不进仓库——换机器时自己建一个。
mod/zig.path
